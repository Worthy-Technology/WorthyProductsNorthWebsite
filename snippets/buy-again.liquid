{% comment %}
  Shared "Buy again" confirmation modal + cart-adding logic, used by the account
  order history table, the single order page, the header reorder icon, and the
  homepage "Buy it again" section. Render this once, globally (see layout/theme.liquid).

  Also emits the logged-in customer's most recent order as a ready-to-use JSON
  payload (id="order-{id}-items"), so surfaces other than the account/order pages
  don't need to rebuild the available/out-of-stock split themselves -- they only
  need a .buy-again-btn with data-order-id matching that order's id.
{% endcomment %}
{%- comment -%} Guests never get a reorder button, so render nothing for them (keeps guest/Lighthouse payload untouched). {%- endcomment -%}
{%- if customer -%}
{%- if customer.orders.size > 0 -%}
  {%- assign last_order = customer.orders | sort: 'created_at' | last -%}
  {%- assign items_available = '' -%}
  {%- assign items_oos = '' -%}
  {%- assign items_all = '' -%}

  {%- for li in last_order.line_items -%}
    {%- comment -%}
      Resolve the CURRENT variant from the live product (li.product), not the order's
      historical variant — products the Odoo sync has recreated (e.g. clearance
      mirrors) keep a stale/unavailable variant id on old line items, which both
      mis-flags stock and sends a dead id to /cart/add.js.
    {%- endcomment -%}
    {%- assign cur_variant = li.product.selected_or_first_available_variant -%}
    {%- if li.product and cur_variant != blank and cur_variant.id -%}
      {%- assign numeric_variant_id = cur_variant.id -%}
      {%- assign qty = li.quantity -%}
      {%- assign name_json = li.title | json -%}
      {%- assign treat_oos = cur_variant.available == false -%}

      {%- capture item_json -%}{"id":{{ numeric_variant_id }},"quantity":{{ qty }},"name":{{ name_json }}}{%- endcapture -%}

      {%- if items_all != '' -%}{%- assign items_all = items_all | append: ',' -%}{%- endif -%}
      {%- assign items_all = items_all | append: item_json -%}

      {%- if treat_oos -%}
        {%- if items_oos != '' -%}{%- assign items_oos = items_oos | append: ',' -%}{%- endif -%}
        {%- assign items_oos = items_oos | append: item_json -%}
      {%- else -%}
        {%- if items_available != '' -%}{%- assign items_available = items_available | append: ',' -%}{%- endif -%}
        {%- assign items_available = items_available | append: item_json -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if items_all != '' -%}
    <script type="application/json" id="order-{{ last_order.id }}-items">
      { "available":[{{ items_available }}], "oos":[{{ items_oos }}], "all":[{{ items_all }}] }
    </script>
  {%- endif -%}
{%- endif -%}

<div id="buy-again-modal" aria-hidden="true" role="dialog" aria-modal="true"
     style="position:fixed; inset:0; display:none; align-items:center; justify-content:center; z-index:9999;">
  <div class="bam-overlay" style="position:absolute; inset:0; background:rgba(0,0,0,0.5);"></div>

  <div class="bam-panel"
       style="position:relative; background:#fff; max-width:560px; width:92%; border-radius:12px; box-shadow:0 10px 30px rgba(0,0,0,.2); padding:20px;">
    <h3 style="margin:0 0 10px 0; font-size:18px;">Some items are not in stock</h3>
    <p>These products are currently not available</p>

    <ul id="bam-oos-list" style="margin:0 0 16px 18px; padding:0; list-style:disc;"></ul>

    <div style="display:flex; gap:10px; justify-content:flex-end;">
      <button type="button" class="button button--secondary button--small" id="bam-cancel">Cancel</button>
      <button type="button" class="button button--primary button--small" id="bam-proceed">Proceed to add rest</button>
    </div>

    <button id="bam-close" aria-label="Close"
            style="position:absolute; top:10px; right:12px; background:transparent; border:0; font-size:20px; cursor:pointer;">×</button>
  </div>
</div>

<script>
  (function () {
    if (window.__buyAgainInit) return;
    window.__buyAgainInit = true;

    function bamOpen(oosNames) {
      const modal = document.getElementById('buy-again-modal');
      const list = document.getElementById('bam-oos-list');
      list.innerHTML = '';
      oosNames.forEach((n) => {
        const li = document.createElement('li');
        li.textContent = n;
        list.appendChild(li);
      });
      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }

    function bamClose() {
      document.getElementById('buy-again-modal').style.display = 'none';
      document.body.style.overflow = '';
    }

    // Add one line item; on failure capture Shopify's real reason (e.g. stock).
    async function addOne(item) {
      try {
        const res = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ items: [item] }),
        });
        if (res.ok) return { ok: true, item };
        let desc = '';
        try {
          const d = await res.json();
          desc = d.description || d.message || '';
        } catch (_) {}
        return { ok: false, item, desc };
      } catch (_) {
        return { ok: false, item, desc: '' };
      }
    }

    // Add items one-by-one so a single out-of-stock line can't block the rest.
    async function addItems(items) {
      const results = [];
      for (const it of items) {
        results.push(await addOne(it));
      }
      return results;
    }

    // Some added, some didn't -> go to cart but tell them what was skipped.
    function finish(results, btn, original) {
      const added = results.filter((r) => r.ok);
      const failed = results.filter((r) => !r.ok);

      if (added.length > 0) {
        if (failed.length > 0) {
          const names = failed.map((r) => r.item.name).join(', ');
          alert(
            added.length +
              ' item(s) added to your cart. We could not add: ' +
              names +
              ' (likely out of stock or low stock).'
          );
        }
        window.location.href = '/cart';
        return;
      }

      // Nothing added at all — surface the first real reason if we have one.
      const reason = (failed.find((r) => r.desc) || {}).desc;
      alert(
        reason
          ? 'Could not add items to your cart: ' + reason
          : 'Could not add these items — they may be out of stock right now.'
      );
      if (btn) {
        btn.disabled = false;
        btn.textContent = original;
      }
    }

    let bamPending = null;

    document.addEventListener('click', async function (e) {
      if (e.target.id === 'bam-close' || e.target.id === 'bam-cancel' || e.target.classList.contains('bam-overlay')) {
        bamClose();
        if (bamPending && bamPending.btn) {
          bamPending.btn.disabled = false;
          bamPending.btn.textContent = bamPending.original;
          bamPending = null;
        }
        return;
      }

      if (e.target.id === 'bam-proceed') {
        if (!bamPending) return;
        const { avail, btn, original } = bamPending;
        bamClose();
        if (!avail.length) {
          alert('The remaining items are out of stock, so there is nothing to add.');
          if (btn) {
            btn.disabled = false;
            btn.textContent = original;
          }
          bamPending = null;
          return;
        }
        const results = await addItems(avail);
        finish(results, btn, original);
        bamPending = null;
        return;
      }

      const btn = e.target.closest('.buy-again-btn');
      if (!btn) return;

      const orderId = btn.dataset.orderId;
      const jsonEl = document.getElementById(`order-${orderId}-items`);
      if (!jsonEl) return;

      const payload = JSON.parse(jsonEl.textContent.trim());
      const oos = payload.oos || [];
      const avail = payload.available || [];

      if (!avail.length && !oos.length) return;

      if (oos.length) {
        bamOpen(oos.map((i) => i.name));
        btn.disabled = true;
        bamPending = { avail, btn, original: btn.textContent };
        btn.textContent = 'Ready to add';
        return;
      }

      btn.disabled = true;
      const original = btn.textContent;
      btn.textContent = 'Adding...';

      const results = await addItems(avail);
      finish(results, btn, original);
    });
  })();
</script>
{%- endif -%}
